Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Book
Bundle-SymbolicName: org.zee;singleton:=true
Bundle-Version: 1.0.0.qualifier
Automatic-Module-Name: org.zee.book
Bundle-RequiredExecutionEnvironment: JavaSE-11
Require-Bundle: org.adempiere.base;bundle-version="6.2.0",
 org.adempiere.plugin.utils;bundle-version="6.2.0",
 org.apache.cxf.cxf-core,
 org.apache.xmlbeans
Service-Component: OSGI-INF/*.xml
Web-ContextPath: api
Bundle-ClassPath: .
Bundle-ActivationPolicy: lazy
Import-Package: com.sun.jdi.event,
 groovyjarjarantlr.debug;version="2.5.3",
 javax.servlet;version="3.1.0",
 javax.servlet.http;version="3.1.0",
 org.json,
 org.osgi.framework,
 org.osgi.service.event;version="1.4.0",
 org.osgi.service.http;version="1.2.0"
